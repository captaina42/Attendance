# Copy to .env (never commit it) and fill in for the deployed instance.

# Public URL of the deployed app. Passkeys are bound to this hostname, and it must be https
# on a real phone. Leave empty for local development (http://localhost:3000).
APP_ORIGIN=https://attendsecure.onrender.com

# Optional explicit overrides. RP_ID defaults to the hostname of APP_ORIGIN.
#RP_ID=attendsecure.onrender.com
#RP_NAME=AttendanceSecure

# Signing secret for login cookies. Generate one with: openssl rand -hex 48
JWT_SECRET=

# Where the database and photos are stored. On a host with a disk, point this at the mount.
DATA_DIR=

# First-run lecturer account (only created when no staff account exists yet).
ADMIN_EMAIL=you@example.com
ADMIN_NAME=Your Name
ADMIN_PASSWORD=

# true when the app runs behind a hosting proxy that terminates HTTPS.
TRUST_PROXY=1
